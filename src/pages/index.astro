const siteUrl = "https://iie-code-craft.vercel.app";
const pageTitle = "CODECRAFT 2026 | Hackathon by IIE HackLab";
const pageDescription =
  "Register for CODECRAFT 2026, the IIE HackLab hackathon at Ideal Institute of Engineering where student teams build software and hardware prototypes with live demos, prizes, and certificates.";
const pageKeywords =
  "CODECRAFT, CODECRAFT 2026, IIE HackLab, Ideal Institute of Engineering hackathon, hardware hackathon, software hardware project competition, student hackathon, software hackathon";
const socialImage = `${siteUrl}/CodeCraft.png`;

const eventStructuredData = {
  "@context": "https://schema.org",
  "@type": "Event",
  name: "CODECRAFT 2026",
  description: pageDescription,
  url: siteUrl,
  image: [socialImage],
  startDate: "2026-08-20T09:00:00+05:30",
  endDate: "2026-09-25T18:00:00+05:30",
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  eventStatus: "https://schema.org/EventScheduled",
  keywords: pageKeywords,
  location: {
    "@type": "Place",
    name: "Ideal Institute of Engineering",
    address: "Ideal Institute of Engineering campus",
  },
  organizer: {
    "@type": "Organization",
    name: "IIE HackLab",
    url: siteUrl,
  },
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={pageKeywords} />
    <meta name="author" content="IIE HackLab" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#020811" />
    <meta name="format-detection" content="telephone=yes" />
    <link rel="canonical" href={siteUrl} />
    <title>{pageTitle}</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CODECRAFT" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="352" />
    <meta property="og:image:height" content="236" />
    <meta
      property="og:image:alt"
      content="CODECRAFT hackathon logo"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImage} />
    <meta
      name="twitter:image:alt"
      content="CODECRAFT hackathon logo"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Orbitron:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/png" href="/CodeCraft.png" />
    <link rel="apple-touch-icon" href="/CodeCraft.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" as="image" href={logoImg.src} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(eventStructuredData)}
    />
  </head>

  <body>
    <!-- ── Page shell ── -->
    <div class="page-shell" id="page-shell">
      <!-- Ambient background orbs -->
      <div
        class="ambient-bg"
        aria-hidden="true"
        style="position:fixed;inset:0;pointer-events:none;z-index:0;"
      >
        <div
          style="position:absolute;width:700px;height:700px;background:#4facfe;top:-100px;left:-200px;border-radius:50%;filter:blur(140px);opacity:0.06;"
        >
        </div>
        <div
          style="position:absolute;width:700px;height:700px;background:#8e2de2;bottom:-100px;right:-150px;border-radius:50%;filter:blur(140px);opacity:0.06;"
        >
        </div>
        <div
          style="position:absolute;width:500px;height:500px;background:#00f2fe;top:40%;left:55%;border-radius:50%;filter:blur(140px);opacity:0.04;transform:translate(-50%,-50%);"
        >
        </div>
      </div>

      <CustomCursor />
      <Loader logoSrc={logoImg.src} />

      <Navbar />

      <main id="main-content">
        <!-- ══════════════════════════════════════════════ HERO ══ -->
        <section class="hero-workbench" id="home" aria-label="CODECRAFT: From Code to Circuit">
          <!-- Spacious Engineering Environment Background -->
          <div class="workbench-bg" aria-hidden="true">
            <div class="wb-grid"></div>
            <div class="wb-pcb-traces"></div>
            <div class="wb-glow glow-center"></div>
            <div class="wb-glow glow-left"></div>
            <div class="wb-glow glow-right"></div>
          </div>

          <div class="wrap hero-wrap">
            <!-- Top Narrative & Branding Header -->
            <header class="hero-header">
              <div class="hero-institution">
                <span class="inst-bracket">[</span>
                <span class="inst-text">IIE HACKLAB • IDEAL INSTITUTE OF ENGINEERING</span>
                <span class="inst-bracket">]</span>
              </div>

              <h1 class="hero-title" aria-label="CODECRAFT">
                <img src={name.src} alt="CODECRAFT" class="hero-title-img" width="540" height="120" />
              </h1>

              <p class="hero-subtitle">WHERE SOFTWARE MEETS HARDWARE</p>

              <p class="hero-desc">
                Bridge the gap between virtual logic and physical circuits.
                Join the ultimate hackathon where raw code meets real engineering.
              </p>

              <div class="hero-actions">
                <button
                  type="button"
                  class="btn-hero-primary"
                  id="hero-register-btn"
                  onclick="window.location.href = '/coming-soon'"
                  data-cursor="[ENTER]"
                >
                  <span>ENTER CODECRAFT</span>
                  <svg class="hero-btn-arrow" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                    <path d="M4 10h12M12 5l5 5-5 5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
                <button
                  type="button"
                  class="btn-hero-secondary"
                  data-scroll-to="#about"
                  id="hero-learn-btn"
                  data-cursor="[EXPLORE]"
                >
                  <span>EXPLORE STACK ↓</span>
                </button>
              </div>
            </header>

            <!-- The Central Engineering Workbench: SOFTWARE → CORE → HARDWARE -->
            <div class="workbench-stage" id="workbench-stage">
              
              <!-- ═══════════ LEFT: SOFTWARE / DEVELOPER CODE PANEL ═══════════ -->
              <div class="wb-col wb-col-software" id="wb-software">
                <div class="wb-panel code-panel" data-cursor="[CODE]">
                  <!-- Terminal Header -->
                  <div class="cp-header">
                    <div class="cp-dots" aria-hidden="true">
                      <span class="dot-r"></span>
                      <span class="dot-y"></span>
                      <span class="dot-g"></span>
                    </div>
                    <span class="cp-file">firmware.ts</span>
                    <span class="cp-status-tag">
                      <span class="cp-status-dot"></span>
                      <span>LIVE</span>
                    </span>
                  </div>

                  <!-- Code Window -->
                  <div class="cp-code-body">
                    <div class="code-line">
                      <span class="ln">01</span>
                      <span class="kw">const</span> <span class="id">system</span> = <span class="fn">initialize</span>();
                    </div>
                    <div class="code-line">
                      <span class="ln">02</span>
                      <span class="fn">connectHardware</span>();
                    </div>
                    <div class="code-line hl-line">
                      <span class="ln">03</span>
                      <span class="fn">compileInnovation</span>();
                    </div>
                  </div>

                  <!-- Live Build Terminal Output -->
                  <div class="cp-build-output">
                    <div class="bo-line" id="bo-line-1">
                      <span class="bo-chevron">&gt;</span> <span class="bo-txt">BUILDING BINARY...</span>
                    </div>
                    <div class="bo-line" id="bo-line-2">
                      <span class="bo-chevron">&gt;</span> <span class="bo-txt">SYNCING LOGIC GATES...</span>
                    </div>
                    <div class="bo-line bo-ready" id="bo-line-3">
                      <span class="bo-chevron">&gt;</span> <span class="bo-txt">TRANSMITTING DATA [OK]</span>
                      <span class="bo-cursor" aria-hidden="true">_</span>
                    </div>
                  </div>

                  <!-- Bus Port Left Output -->
                  <div class="cp-bus-port" title="DATA_BUS_OUT">
                    <span class="port-label">BUS_OUT</span>
                    <span class="port-node"></span>
                  </div>
                </div>
              </div>

              <!-- ═══════════ BUS 1: DATA TRANSMISSION CONDUIT (CODE → CORE) ═══════════ -->
              <div class="wb-conduit conduit-left" aria-hidden="true">
                <svg class="conduit-svg" viewBox="0 0 120 80" preserveAspectRatio="none">
                  <!-- Multi-lane circuit traces -->
                  <path class="conduit-path-bg" d="M 0,20 L 50,20 L 70,40 L 120,40" />
                  <path class="conduit-path-bg" d="M 0,40 L 40,40 L 60,40 L 120,40" />
                  <path class="conduit-path-bg" d="M 0,60 L 50,60 L 70,40 L 120,40" />

                  <path class="conduit-path-active p-left-1" d="M 0,20 L 50,20 L 70,40 L 120,40" />
                  <path class="conduit-path-active p-left-2" d="M 0,40 L 40,40 L 60,40 L 120,40" />
                  <path class="conduit-path-active p-left-3" d="M 0,60 L 50,60 L 70,40 L 120,40" />
                  
                  <!-- Traveling Data Packets -->
                  <circle class="data-packet pkt-1" r="3">
                    <animateMotion dur="1.8s" repeatCount="indefinite" path="M 0,20 L 50,20 L 70,40 L 120,40" />
                  </circle>
                  <circle class="data-packet pkt-2" r="2.5">
                    <animateMotion dur="2.2s" begin="0.6s" repeatCount="indefinite" path="M 0,40 L 40,40 L 60,40 L 120,40" />
                  </circle>
                  <circle class="data-packet pkt-3" r="3">
                    <animateMotion dur="2.5s" begin="1.2s" repeatCount="indefinite" path="M 0,60 L 50,60 L 70,40 L 120,40" />
                  </circle>
                </svg>
                <div class="conduit-label">DATA BUS // TX &rarr;</div>
              </div>

              <!-- ═══════════ CENTER: CODECRAFT CORE (ENGINEERING CENTERPIECE) ═══════════ -->
              <div class="wb-col wb-col-core" id="wb-core">
                <div class="core-assembly" id="core-assembly" data-cursor="[CORE]">
                  <!-- Ambient Core Aura -->
                  <div class="core-aura" aria-hidden="true"></div>

                  <!-- Rotating Outer Technical Rings -->
                  <svg class="core-tech-ring ring-outer" viewBox="0 0 280 280" aria-hidden="true">
                    <circle cx="140" cy="140" r="134" class="ring-track" />
                    <circle cx="140" cy="140" r="134" class="ring-dashes" />
                    <circle cx="140" cy="140" r="126" class="ring-reticle" />
                  </svg>

                  <!-- Counter-rotating Inner Gear Ring -->
                  <svg class="core-tech-ring ring-inner" viewBox="0 0 240 240" aria-hidden="true">
                    <circle cx="120" cy="120" r="112" class="ring-track" />
                    <circle cx="120" cy="120" r="112" class="ring-gear-teeth" />
                  </svg>

                  <!-- Core Chassis with CODECRAFT Emblem -->
                  <div class="core-chassis" id="core-chassis">
                    <div class="chassis-inner">
                      <img
                        src={logoImg.src}
                        alt="CODECRAFT Core Emblem"
                        class="core-logo-img"
                        width="84"
                        height="84"
                        loading="eager"
                      />
                      <div class="core-energy-flare" aria-hidden="true"></div>
                    </div>
                    <!-- Technical Node Pins on Core -->
                    <div class="core-pin pin-left" aria-hidden="true"></div>
                    <div class="core-pin pin-right" aria-hidden="true"></div>
                    <div class="core-pin pin-top" aria-hidden="true"></div>
                    <div class="core-pin pin-bottom" aria-hidden="true"></div>
                  </div>

                  <!-- Center Identity & Telemetry Tag -->
                  <div class="core-telemetry">
                    <span class="tele-dot"></span>
                    <span class="tele-text">CODECRAFT_CORE</span>
                  </div>
                </div>
              </div>

              <!-- ═══════════ BUS 2: CIRCUIT TRACE CONDUIT (HARDWARE → CORE) ═══════════ -->
              <div class="wb-conduit conduit-right" aria-hidden="true">
                <svg class="conduit-svg" viewBox="0 0 120 80" preserveAspectRatio="none">
                  <!-- Multi-lane circuit traces converging inward from hardware (120) to center core (0,40) -->
                  <path class="conduit-path-bg gold" d="M 120,20 L 70,20 L 50,40 L 0,40" />
                  <path class="conduit-path-bg gold" d="M 120,40 L 80,40 L 60,40 L 0,40" />
                  <path class="conduit-path-bg gold" d="M 120,60 L 70,60 L 50,40 L 0,40" />

                  <path class="conduit-path-active gold p-right-1" d="M 120,20 L 70,20 L 50,40 L 0,40" />
                  <path class="conduit-path-active gold p-right-2" d="M 120,40 L 80,40 L 60,40 L 0,40" />
                  <path class="conduit-path-active gold p-right-3" d="M 120,60 L 70,60 L 50,40 L 0,40" />

                  <!-- Traveling Circuit Electric Pulses flowing inward to center core -->
                  <circle class="circuit-pulse cp-1" r="3">
