---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Loader from "../components/Loader.astro";
import CustomCursor from "../components/CustomCursor.astro";
import AnimatedPage from "../components/AnimatedPage.tsx";
import logoImg from "../assets/images/logo-high.png";
import "../styles/global.css";
import ayush from "../assets/people/Ayush.jpeg";
import rahidul from "../assets/people/Rahidul.png";
import neel from "../assets/people/Neel.jpeg";
import debankan from "../assets/people/Debankan.jpeg";
import ronit from "../assets/people/ronit.png";
import {
  eventStructuredData,
  pageDescription,
  pageKeywords,
  pageTitle,
  siteUrl,
  socialImage,
} from "../lib/siteConfig";

// ─── Timeline data ─────────────────────────────────────────────────────────────
const timelineTones = ["cyan", "blue", "orange", "purple", "blue", "cyan"];
const timelinePattern = [
  { row: 1, slot: 1 },
  { row: 1, slot: 2 },
  { row: 1, slot: 3 },
  { row: 2, slot: 3 },
  { row: 2, slot: 2 },
  { row: 2, slot: 1 },
];

const timelineStops = [
  { title: "Registration Opens",    date: "05 September",    isoDate: "2026-09-05", desc: "Sign up your team and claim your spot" },
  { title: "PPT Submission Starts", date: "10 September", isoDate: "2026-09-10", desc: "Submit your presentation slides" },
  { title: "Registration Closes",   date: "20 September", isoDate: "2026-09-20", desc: "Last chance to register your team" },
  { title: "PPT Submission Ends",   date: "22 September", isoDate: "2026-09-22", desc: "Deadline for all submissions" },
  { title: "Project Presentation",  date: "26 September", isoDate: "2026-09-26", desc: "Demo your project to the judges" },
  { title: "Award Ceremony",        date: "28 September", isoDate: "2026-09-28", desc: "Winners announced & prizes distributed" },
].map((item, index) => ({
  ...item,
  icon: "",
  ...(timelinePattern[index] ?? { row: Math.floor(index / 3) + 1, slot: (index % 3) + 1 }),
  tone: timelineTones[index % timelineTones.length],
}));

// ─── Organizers ────────────────────────────────────────────────────────────────
const organizers = [
  { name: "Ayush Choudhary", init: "AC", github: "https://github.com/AR128",         linkedin: "https://www.linkedin.com/in/ayush-choudhary-920a88324/",  role: "Organizer", imageUrl: ayush.src    },
  { name: "Rahidul Khan",    init: "RK", github: "https://github.com/Rahidul2006",    linkedin: "https://www.linkedin.com/in/rahidul-khan-6a3922269",       role: "Organizer", imageUrl: rahidul.src  },
  { name: "Nilotpal Das",    init: "ND", github: "https://github.com/NilotpalDas008", linkedin: "https://www.linkedin.com/in/nilotpal-das-95291b2a2",       role: "Organizer", imageUrl: neel.src     },
  { name: "Ronit Banerjee",  init: "RB", github: "https://github.com/Ronit77777",     linkedin: "https://www.linkedin.com/in/ronit-banerjee-2232b61a3/",    role: "Organizer", imageUrl: ronit.src           },
  { name: "Debankan Dutta",  init: "DD", github: "https://github.com/dev-debankan",   linkedin: "https://www.linkedin.com/in/debankan-dutta-b73688336/",    role: "Organizer", imageUrl: debankan.src },
];

// ─── Static data ────────────────────────────────────────────────────────────────
const prizes = [
  { place: "1st", amount: "₹2,000", emoji: "🥇", rank: 1 },
  { place: "2nd", amount: "₹1,000", emoji: "🥈", rank: 2 },
  { place: "3rd", amount: "₹500",   emoji: "🥉", rank: 3 },
];

const rules = [
  { text: "Team size: 2–4 members from any year (1st–4th)", icon: "👥" },
  { text: "All team members must be from the college",       icon: "🏫" },
  { text: "Teams must submit PPT before the deadline",       icon: "📅" },
  { text: "Ideas must be original and not copied from existing projects", icon: "📝" },
  { text: "The video must be uploaded to YouTube and the link shared",    icon: "🔴" },
  { text: "Plagiarism of code or ideas will lead to DQ",    icon: "🚫" },
  { text: "Teams can use open-source libraries & frameworks",icon: "📦" },
  { text: "Final project must be demonstrated live",         icon: "🎥" },
];

const submissionRequirements = [
  { title: "PPT Submission",       desc: "Mandatory presentation slides covering your project",                                                               icon: "📊", tag: "Required", color: "orange" },
  { title: "GitHub Repository",    desc: "Optional: share your open source code repository",                                                                 icon: "💻", tag: "Optional", color: "blue"   },
  { title: "Software Demo",        desc: "Optional: a working demo of your software component [It can be MVP link or youtube video link]",                   icon: "⚙️",  tag: "Optional", color: "blue"   },
  { title: "Hardware Demo Video",  desc: "Optional: showcase your hardware integration on video, The video must be uploaded to YouTube and the link shared",  icon: "🎥", tag: "Optional", color: "blue"   },
];

const features = [
  { icon: "💡", num: "01", title: "Innovation First",    desc: "Build solutions combining software intelligence with hardware creativity." },
  { icon: "⚙️",  num: "02", title: "Integration Focus",  desc: "Master embedded systems, IoT, and web platforms in one cohesive prototype." },
  { icon: "🚀", num: "03", title: "Real Impact",         desc: "Cross-year teams (1st–4th year) working on projects that matter." },
];

---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={pageKeywords} />
    <meta name="author" content="IIE Tech Club" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#020811" />
    <meta name="format-detection" content="telephone=yes" />
    <link rel="canonical" href={siteUrl} />
    <title>{pageTitle}</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CODECRAFT" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="352" />
    <meta property="og:image:height" content="236" />
    <meta property="og:image:alt" content="CODECRAFT hackathon logo" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="CODECRAFT hackathon logo" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Orbitron:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/png" href="/CodeCraft.png" />
    <link rel="apple-touch-icon" href="/CodeCraft.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" as="image" href={logoImg.src} />
    <script type="application/ld+json" set:html={JSON.stringify(eventStructuredData)} />
  </head>

  <body>
    <div class="page-shell" id="page-shell">
      <CustomCursor />
      <Loader logoSrc={logoImg.src} />
      <Navbar />

      <!-- Framer Motion React Island — all animated sections -->
      <AnimatedPage
        client:load
        logoSrc={logoImg.src}
        timelineStops={timelineStops}
        organizers={organizers}
        prizes={prizes}
        rules={rules}
        submissionRequirements={submissionRequirements}
        features={features}
      />

      <Footer />
    </div>

    <!-- Reveal animations are kept in the page shell so they work for static sections. -->
    <script is:inline>
      if (!window.__CODECRAFT_LOGGED__) {
        window.__CODECRAFT_LOGGED__ = true;
        const headerStyle = "background: linear-gradient(135deg, #00f2fe 0%, #4d79ff 100%); color: white; font-weight: bold; padding: 6px 12px; border-radius: 4px; font-size: 13px;";
        const itemStyle = "color: #00f2fe; font-weight: bold; padding: 4px 8px; border: 2px solid #00f2fe; border-radius: 4px; margin-top: 4px;";
        console.log("%c⚡ CODECRAFT PLATFORM INITIALIZED", headerStyle);
      }

      (() => {
        // Reveal animations trigger (ONCE only)
        const revealIo = new IntersectionObserver(entries => {
          entries.forEach(en => {
            if (en.isIntersecting) {
              en.target.classList.add('in-view');
              revealIo.unobserve(en.target);
            }
          });
        }, { threshold: 0.15 });
        document.querySelectorAll('.reveal, .reveal-stagger').forEach(el => revealIo.observe(el));
      })();

    </script>
  </body>
</html>
