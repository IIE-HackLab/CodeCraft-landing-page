---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Loader from "../components/Loader.astro";
import CustomCursor from "../components/CustomCursor.astro";
import AnimatedPage from "../components/AnimatedPage.tsx";
import logoImg from "../assets/images/logo-high.png";
import "../styles/global.css";
import ayush from "../assets/people/Ayush.jpeg";
import rahidul from "../assets/people/Rahidul.jpeg";
import neel from "../assets/people/Neel.jpeg";
import debankan from "../assets/people/Debankan.jpeg";
import ronit from "../assets/people/ronit.png";
import {
  eventStructuredData,
  pageDescription,
  pageKeywords,
  pageTitle,
  siteUrl,
  socialImage,
} from "../lib/siteConfig";

// ─── Timeline data ─────────────────────────────────────────────────────────────
const timelineTones = ["cyan", "blue", "orange", "purple", "blue", "cyan"];
const timelinePattern = [
  { row: 1, slot: 1 },
  { row: 1, slot: 2 },
  { row: 1, slot: 3 },
  { row: 2, slot: 3 },
  { row: 2, slot: 2 },
  { row: 2, slot: 1 },
];

const timelineStops = [
  { title: "Registration Opens",    date: "05 September",    isoDate: "2026-09-05", desc: "Sign up your team and claim your spot" },
  { title: "PPT Submission Starts", date: "10 September", isoDate: "2026-09-10", desc: "Submit your presentation slides" },
  { title: "Registration Closes",   date: "20 September", isoDate: "2026-09-20", desc: "Last chance to register your team" },
  { title: "PPT Submission Ends",   date: "22 September", isoDate: "2026-09-22", desc: "Deadline for all submissions" },
  { title: "Project Presentation",  date: "26 September", isoDate: "2026-09-26", desc: "Demo your project to the judges" },
  { title: "Award Ceremony",        date: "28 September", isoDate: "2026-09-28", desc: "Winners announced & prizes distributed" },
].map((item, index) => ({
  ...item,
  icon: "",
  ...(timelinePattern[index] ?? { row: Math.floor(index / 3) + 1, slot: (index % 3) + 1 }),
  tone: timelineTones[index % timelineTones.length],
}));

// ─── Organizers ────────────────────────────────────────────────────────────────
const organizers = [
  { name: "Ayush Choudhary", init: "AC", github: "https://github.com/AR128",         linkedin: "https://www.linkedin.com/in/ayush-choudhary-920a88324/",  role: "Organizer", imageUrl: ayush.src    },
  { name: "Rahidul Khan",    init: "RK", github: "https://github.com/Rahidul2006",    linkedin: "https://www.linkedin.com/in/rahidul-khan-6a3922269",       role: "Organizer", imageUrl: rahidul.src  },
  { name: "Nilotpal Das",    init: "ND", github: "https://github.com/NilotpalDas008", linkedin: "https://www.linkedin.com/in/nilotpal-das-95291b2a2",       role: "Organizer", imageUrl: neel.src     },
  { name: "Ronit Banerjee",  init: "RB", github: "https://github.com/Ronit77777",     linkedin: "https://www.linkedin.com/in/ronit-banerjee-2232b61a3/",    role: "Organizer", imageUrl: ronit.src           },
  { name: "Debankan Dutta",  init: "DD", github: "https://github.com/dev-debankan",   linkedin: "https://www.linkedin.com/in/debankan-dutta-b73688336/",    role: "Organizer", imageUrl: debankan.src },
];

// ─── Static data ────────────────────────────────────────────────────────────────
const prizes = [
  { place: "1st", amount: "₹2,000", emoji: "🥇", rank: 1 },
  { place: "2nd", amount: "₹1,000", emoji: "🥈", rank: 2 },
  { place: "3rd", amount: "₹500",   emoji: "🥉", rank: 3 },
];

const rules = [
  { text: "Team size: 2–4 members from any year (1st–4th)", icon: "👥" },
  { text: "All team members must be from the college",       icon: "🏫" },
  { text: "Teams must submit PPT before the deadline",       icon: "📅" },
  { text: "Ideas must be original and not copied from existing projects", icon: "📝" },
  { text: "The video must be uploaded to YouTube and the link shared",    icon: "🔴" },
  { text: "Plagiarism of code or ideas will lead to DQ",    icon: "🚫" },
  { text: "Teams can use open-source libraries & frameworks",icon: "📦" },
  { text: "Final project must be demonstrated live",         icon: "🎥" },
];

const submissionRequirements = [
  { title: "PPT Submission",       desc: "Mandatory presentation slides covering your project",                                                               icon: "📊", tag: "Required", color: "orange" },
  { title: "GitHub Repository",    desc: "Optional: share your open source code repository",                                                                 icon: "💻", tag: "Optional", color: "blue"   },
  { title: "Software Demo",        desc: "Optional: a working demo of your software component [It can be MVP link or youtube video link]",                   icon: "⚙️",  tag: "Optional", color: "blue"   },
  { title: "Hardware Demo Video",  desc: "Optional: showcase your hardware integration on video, The video must be uploaded to YouTube and the link shared",  icon: "🎥", tag: "Optional", color: "blue"   },
];

const features = [
  { icon: "💡", num: "01", title: "Innovation First",    desc: "Build solutions combining software intelligence with hardware creativity." },
  { icon: "⚙️",  num: "02", title: "Integration Focus",  desc: "Master embedded systems, IoT, and web platforms in one cohesive prototype." },
  { icon: "🚀", num: "03", title: "Real Impact",         desc: "Cross-year teams (1st–4th year) working on projects that matter." },
];

---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={pageKeywords} />
    <meta name="author" content="IIE HackLab" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#020811" />
    <meta name="format-detection" content="telephone=yes" />
    <link rel="canonical" href={siteUrl} />
    <title>{pageTitle}</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CODECRAFT" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="352" />
    <meta property="og:image:height" content="236" />
    <meta property="og:image:alt" content="CODECRAFT hackathon logo" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="CODECRAFT hackathon logo" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Orbitron:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/png" href="/CodeCraft.png" />
    <link rel="apple-touch-icon" href="/CodeCraft.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" as="image" href={logoImg.src} />
    <script type="application/ld+json" set:html={JSON.stringify(eventStructuredData)} />
  </head>

  <body>
    <div class="page-shell" id="page-shell">
      <CustomCursor />
      <Loader logoSrc={logoImg.src} />
      <Navbar />

      <!-- Framer Motion React Island — all animated sections -->
      <AnimatedPage
        client:load
        logoSrc={logoImg.src}
        timelineStops={timelineStops}
        organizers={organizers}
        prizes={prizes}
        rules={rules}
        submissionRequirements={submissionRequirements}
        features={features}
      />

      <Footer />
    </div>

    <!-- Reveal animations are kept in the page shell so they work for static sections. -->
    <script is:inline>
      if (!window.__CODECRAFT_LOGGED__) {
        window.__CODECRAFT_LOGGED__ = true;
        const headerStyle = "background: linear-gradient(135deg, #00f2fe 0%, #4d79ff 100%); color: white; font-weight: bold; padding: 6px 12px; border-radius: 4px; font-size: 13px;";
        const itemStyle = "color: #00f2fe; font-weight: bold; padding: 4px 8px; border: 2px solid #00f2fe; border-radius: 4px; margin-top: 4px;";
        console.log("%c⚡ CODECRAFT PLATFORM INITIALIZED", headerStyle);
      }

      (() => {
        // Reveal animations trigger (ONCE only)
        const revealIo = new IntersectionObserver(entries => {
          entries.forEach(en => {
            if (en.isIntersecting) {
              en.target.classList.add('in-view');
              revealIo.unobserve(en.target);
            }
          });
        }, { threshold: 0.15 });
        document.querySelectorAll('.reveal, .reveal-stagger').forEach(el => revealIo.observe(el));
      })();

      // ── Counter animation
      const animateCount = (node) => {
        const target = +node.dataset.counter || 0;
        const suffix = node.dataset.suffix || "";
        const dur = 1400,
          start = performance.now();
        const tick = (now) => {
          const p = Math.min((now - start) / dur, 1);
          node.textContent =
            Math.round(target * (1 - Math.pow(1 - p, 3))) + suffix;
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      };
      const co = new IntersectionObserver(
        (entries) => {
          entries.forEach((en) => {
            if (en.isIntersecting) {
              animateCount(en.target);
              co.unobserve(en.target);
            }
          });
        },
        { threshold: 0.5 },
      );
      document
        .querySelectorAll("[data-counter]")
        .forEach((el) => co.observe(el));

      // ── Countdown to event (21 Sep 2026)
      const target = new Date("2026-09-21T09:00:00");
      const pad = (n) => String(n).padStart(2, "0");
      const updateCD = () => {
        const diff = target - Date.now();
        if (diff <= 0) {
          document.getElementById("countdown")?.remove();
          return;
        }
        const s = Math.floor(diff / 1000);
        const elDays = document.getElementById("cd-days");
        const elHours = document.getElementById("cd-hours");
        const elMins = document.getElementById("cd-mins");
        const elSecs = document.getElementById("cd-secs");
        
        if (elDays) elDays.textContent = pad(Math.floor(s / 86400));
        if (elHours) elHours.textContent = pad(Math.floor((s % 86400) / 3600));
        if (elMins) elMins.textContent = pad(Math.floor((s % 3600) / 60));
        if (elSecs) elSecs.textContent = pad(s % 60);
      };
      updateCD();
      setInterval(updateCD, 1000);

      // ── 3D Tilt Effect
      document.querySelectorAll('[data-tilt]').forEach(el => {
        // Only apply on desktop
        if (window.matchMedia("(pointer: coarse)").matches) return;
        
        el.addEventListener('mousemove', e => {
          const rect = el.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          const centerX = rect.width / 2;
          const centerY = rect.height / 2;
          const rotateX = ((y - centerY) / centerY) * -10;
          const rotateY = ((x - centerX) / centerX) * 10;
          
          el.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.02, 1.02, 1.02)`;
          el.style.transition = 'transform 0.1s ease';
          
          // Dynamic shine effect
          if(!el.querySelector('.tilt-shine')) {
            const shine = document.createElement('div');
            shine.className = 'tilt-shine';
            shine.style.position = 'absolute';
            shine.style.inset = '0';
            shine.style.background = 'radial-gradient(circle at 50% 50%, rgba(0, 242, 254, 0.15) 0%, transparent 60%)';
            shine.style.pointerEvents = 'none';
            shine.style.zIndex = '10';
            shine.style.opacity = '0';
            shine.style.transition = 'opacity 0.3s';
            shine.style.borderRadius = 'inherit';
            
            // Check if element is relatively positioned
            const style = window.getComputedStyle(el);
            if (style.position === 'static') {
              el.style.position = 'relative';
            }
            
            el.appendChild(shine);
          }
          
          const shine = el.querySelector('.tilt-shine');
          if(shine) {
            shine.style.opacity = '1';
            shine.style.background = `radial-gradient(circle at ${x}px ${y}px, rgba(0, 242, 254, 0.2) 0%, transparent 60%)`;
          }
        });
        
        el.addEventListener('mouseleave', () => {
          el.style.transform = '';
          el.style.transition = 'transform 0.5s ease';
          const shine = el.querySelector('.tilt-shine');
          if(shine) shine.style.opacity = '0';
        });
      });

      // ── Magnetic Buttons
      document.querySelectorAll('[data-magnetic]').forEach(btn => {
        if (window.matchMedia("(pointer: coarse)").matches) return;
        
        btn.addEventListener('mousemove', e => {
          const rect = btn.getBoundingClientRect();
          const x = e.clientX - rect.left - rect.width / 2;
          const y = e.clientY - rect.top - rect.height / 2;
          btn.style.transform = `translate(${x * 0.3}px, ${y * 0.3}px)`;
        });
        btn.addEventListener('mouseleave', () => {
          btn.style.transform = 'translate(0px, 0px)';
        });
      });

      // ── Scramble Text Effect on Scroll (for Headings)
      const scrambleObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const heading = entry.target;
            heading.classList.add('glitch-active');
            let iterations = 0;
            const originalText = heading.getAttribute('data-text') || heading.innerText;
            const letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@#$%&*";
            
            clearInterval(heading.glitchInterval);
            heading.glitchInterval = setInterval(() => {
              heading.innerText = originalText.split("").map((letter, index) => {
                if(index < iterations) return originalText[index];
                if(letter === " " || letter === "\n") return letter; // preserve spaces and line breaks
                return letters[Math.floor(Math.random() * letters.length)];
              }).join("");
              
              if(iterations >= originalText.length){
                clearInterval(heading.glitchInterval);
                heading.innerText = originalText;
                heading.classList.remove('glitch-active');
              }
              iterations += 1 / 3; // speed of unscrambling
            }, 30);
            
            observer.unobserve(heading);
          }
        });
      }, { threshold: 0.8 }); // Trigger when 80% visible
      
      document.querySelectorAll('.section-title:not([data-no-scramble]), .hero-heading-craft').forEach(heading => {
        heading.setAttribute('data-text', heading.innerText);
        // Pre-scramble text so it's fully scrambled before scrolling into view
        const letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@#$%&*";
        heading.innerText = heading.innerText.split("").map(char => 
          (char === " " || char === "\n") ? char : letters[Math.floor(Math.random() * letters.length)]
        ).join(""); 
        scrambleObserver.observe(heading);
      });
      
      // ── Typewriter effect for terminal commands
      let terminalTimeouts = [];
      const typeTerminal = () => {
         const termHistory = document.getElementById('term-history');
         const termLines = termHistory ? termHistory.querySelectorAll('.t-line') : [];
         const termInput = document.getElementById('term-input');
         const activePrompt = document.querySelector('.active-prompt');
         
         if(termLines.length > 0) {
            if (activePrompt) activePrompt.style.opacity = '0';
            
            terminalTimeouts.forEach(clearTimeout);
            terminalTimeouts = [];
            
            termLines.forEach(line => {
              line.style.opacity = '0';
              line.style.animation = 'none';
            });
            
            void termLines[0].offsetWidth;

            let delay = 0;
            termLines.forEach((line, index) => {
               const tid = setTimeout(() => {
                  line.style.opacity = '1';
                  line.style.animation = 'line-appear 0.2s forwards';
                  
                  // When last line is typed, show the input prompt
                  if (index === termLines.length - 1) {
                    setTimeout(() => {
                      if (activePrompt) activePrompt.style.opacity = '1';
                      if (termInput) termInput.focus();
                    }, 500);
                  }
               }, delay);
               terminalTimeouts.push(tid);
               delay += 600;
            });
         }
      };

      // ── Interactive Terminal Input Handling
      const termInput = document.getElementById('term-input');
      const termHistory = document.getElementById('term-history');
      const termBody = document.getElementById('term-body');

      const addLine = (text, isCommand = false, isError = false) => {
        const line = document.createElement('div');
        line.className = isCommand ? 't-line' : 't-line command-output';
        if (isError) line.style.color = '#ff2a00';
        
        if (isCommand) {
          line.innerHTML = `<span class="t-prompt">root@codecraft:~#</span> ${text}`;
        } else {
          line.innerText = text;
        }
        
        termHistory.appendChild(line);
        if (termBody) termBody.scrollTop = termBody.scrollHeight;
      };

      const commands = {
        help: () => {
          const helpData = [
            { cmd: 'help', desc: 'Display all available system protocols.' },
            { cmd: 'about', desc: 'Learn about the CODECRAFT mission and vision.' },
            { cmd: 'status', desc: 'Check real-time hardware vitals and sync state.' },
            { cmd: 'register', desc: 'Initiate secure uplink to the participant portal.' },
            { cmd: 'overclock', desc: 'Toggle performance bypass (WARNING: Thermal Risk).' },
            { cmd: 'ls', desc: 'List active system configuration files.' },
            { cmd: 'whoami', desc: 'Display current user credentials and access level.' },
            { cmd: 'hack', desc: 'Attempt unauthorized firewall penetration.' },
            { cmd: 'clear', desc: 'Purge terminal history and reset buffer.' }
          ];

          addLine("ACCESSING CORE COMMAND DIRECTORY...", false);
          helpData.forEach((item, i) => {
            setTimeout(() => {
              addLine(`${item.cmd.padEnd(12)} - ${item.desc}`, false);
            }, (i + 1) * 150);
          });
          return null;
        },
        clear: () => {
          termHistory.innerHTML = '';
          return null;
        },
        ls: () => "init_hardware.sh  execute_hackathon.exe  secrets.txt  neural_link.bin",
        whoami: () => "GUEST_USER // UNAUTHORIZED // ACCESS_LEVEL: 0",
        about: () => "CODECRAFT 2026: Where Software Meets Hardware. Bridge the gap between virtual logic and physical circuits.",
        status: () => isOverclocked ? "SYSTEM_STATE: OVERCLOCKED // CRITICAL_HEAT // BYPASS_ACTIVE" : "SYSTEM_STATE: OPTIMAL // SYNC_STABLE",
        register: () => {
          addLine("INITIATING SECURE UPLINK TO REGISTRATION_SERVER...", false);
          setTimeout(() => addLine("Handshake established... [ENCRYPTED]", false), 400);
          setTimeout(() => addLine("Redirecting to participant dashboard...", false), 800);
          setTimeout(() => {
            window.open('https://participant-dashboard.vercel.app', '_blank');
          }, 1200);
          return "UPLINK_SUCCESSFUL. OPENING PORTAL...";
        },
        hack: () => {
          addLine("INITIATING BRUTE-FORCE PROTOCOL...", false);
          setTimeout(() => addLine("Searching for vulnerability... [FOUND]", false), 500);
          setTimeout(() => addLine("Injecting SQLi payloads into core db...", false), 1200);
          setTimeout(() => addLine("Decrypting admin_shadow... [####------] 42%", false), 1800);
          setTimeout(() => {
            addLine("CRITICAL ERROR: INTRUSION DETECTED", false, true);
            addLine("UPLINK TRACED TO LOCAL NODE", false, true);
            addLine("ALERT: AUTHORITIES NOTIFIED", false, true);
            addLine("INITIATING SYSTEM LOCKDOWN...", false, true);
            const term = document.getElementById('interactive-terminal');
            if (term) {
              term.classList.add('term-shake');
              setTimeout(() => term.classList.remove('term-shake'), 400);
            }
          }, 2800);
          return "PROTOCOL_0: ACCESS_REJECTED_BY_FIREWALL";
        },
        overclock: () => {
          const mcu = document.getElementById('interactive-mcu');
          const shell = document.getElementById('page-shell');
          if (mcu) mcu.click();
          
          if (!isOverclocked) {
             // We are about to be overclocked because click() toggles it
             addLine("BYPASSING HARDWARE SAFETY LIMITS...", false, true);
             setTimeout(() => addLine("Voltages increased: 1.2V -> 1.85V [CRITICAL]", false, true), 400);
             setTimeout(() => addLine("Fan RPM: 100% [INSUFFICIENT_COOLING]", false, true), 800);
             setTimeout(() => addLine("WARNING: CORE_TEMP @ 108°C", false, true), 1200);
             shell?.classList.add('critical-state');
             return "SYSTEM OVERCLOCKED. PERFORMANCE PEAKED. STABILITY: 12%";
          } else {
             shell?.classList.remove('critical-state');
             return "Overclock sequence TERMINATED. Cooling initiated.";
          }
        }
      };

      if (termInput) {
        termInput.addEventListener('input', () => {
          // Dynamic width adjustment
          termInput.style.width = (termInput.value.length + 1) + "ch";
        });

        termInput.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') {
            const input = termInput.value.trim().toLowerCase();
            if (input) {
              addLine(termInput.value, true);
              
              if (commands[input]) {
                const output = commands[input]();
                if (output) addLine(output);
              } else {
                addLine(`Command not found: ${input}. Type 'help' for available commands.`, false, true);
              }
            }
            termInput.value = '';
            termInput.style.width = '2px';
          }
        });

        // Focus input whenever terminal is clicked
        const termContainer = document.getElementById('interactive-terminal');
        if (termContainer) {
          termContainer.addEventListener('click', () => termInput.focus());
        }

        // ── Resize Logic ──
        if (termContainer) {
          const resizers = termContainer.querySelectorAll('.resizer-h');
          let isResizing = false;

          resizers.forEach(resizer => {
            resizer.addEventListener('mousedown', (e) => {
              isResizing = true;
              const direction = resizer.getAttribute('data-direction');
              const startX = e.clientX;
              const startY = e.clientY;
              const startWidth = termContainer.offsetWidth;
              const startHeight = termContainer.offsetHeight;
              const startLeft = termContainer.offsetLeft;
              const startTop = termContainer.offsetTop;

              const onMouseMove = (moveEvent) => {
                if (!isResizing) return;

                if (direction === 'r') {
                  termContainer.style.width = startWidth + (moveEvent.clientX - startX) + 'px';
                } else if (direction === 'b') {
                  termContainer.style.height = startHeight + (moveEvent.clientY - startY) + 'px';
                } else if (direction === 'l') {
                  const newWidth = startWidth - (moveEvent.clientX - startX);
                  if (newWidth > 280) {
                    termContainer.style.width = newWidth + 'px';
                    termContainer.style.left = startLeft + (moveEvent.clientX - startX) + 'px';
                  }
                } else if (direction === 't') {
                  const newHeight = startHeight - (moveEvent.clientY - startY);
                  if (newHeight > 200) {
                    termContainer.style.height = newHeight + 'px';
                    termContainer.style.top = startTop + (moveEvent.clientY - startY) + 'px';
                  }
                }
              };

              const onMouseUp = () => {
                isResizing = false;
                document.removeEventListener('mousemove', onMouseMove);
                document.removeEventListener('mouseup', onMouseUp);
              };

              document.addEventListener('mousemove', onMouseMove);
              document.addEventListener('mouseup', onMouseUp);
              e.preventDefault();
            });
          });
        }
      }      
      const termObserver = new IntersectionObserver((entries) => {
         if(entries[0].isIntersecting) {
            typeTerminal();
            termObserver.disconnect();
         }
      });
      const terminalElement = document.querySelector('.glass-terminal');
      if(terminalElement) termObserver.observe(terminalElement);

      // Terminal Interactive Reboot
      const termRebootBtn = document.getElementById('term-reboot-btn');
      if(termRebootBtn) {
        termRebootBtn.addEventListener('click', () => {
          typeTerminal(); // Re-run typing animation
        });
      }

      // Interactive MCU Overclocking & Live HUD
      let isOverclocked = false;
      const mcuBoard = document.getElementById('interactive-mcu');
      const latNode = document.querySelector('.hud-bl .hud-val');
      const stateNode = document.querySelector('.hud-tr .hud-val');
      let hudInterval;

      const updateHud = () => {
        if (!latNode) return;
        
        if (isOverclocked) {
          // Overclocked HUD logic
          latNode.innerText = `${Math.floor(Math.random() * 4 + 1)}ms`; // 1-4ms latency
          latNode.style.color = "#ff2a00";
          latNode.style.textShadow = "0 0 10px #ff2a00";
          
          if (stateNode) {
            stateNode.innerText = "OVERCLOCKED";
            stateNode.style.color = "#ff2a00";
            stateNode.style.textShadow = "0 0 15px #ff2a00";
          }
        } else {
          // Normal HUD logic
          latNode.innerText = `${Math.floor(Math.random() * 20 + 8)}ms`;
          latNode.style.color = "#00f2fe";
          latNode.style.textShadow = "0 0 10px #00f2fe";
          
          if(stateNode && Math.random() > 0.8) {
            stateNode.innerText = "SYNCING";
            stateNode.style.color = "#ffbd2e";
            stateNode.style.textShadow = "0 0 10px #ffbd2e";
            setTimeout(() => {
              if(!isOverclocked) { // Prevent overriding overclock state
                stateNode.innerText = "OPTIMAL";
                stateNode.style.color = "#00f2fe";
                stateNode.style.textShadow = "0 0 10px #00f2fe";
              }
            }, 800);
          }
        }
      };

      // Initial HUD setup
      hudInterval = setInterval(updateHud, 2000);

      if (mcuBoard) {
        mcuBoard.addEventListener('click', () => {
          isOverclocked = !isOverclocked;
          
          if (isOverclocked) {
            mcuBoard.classList.add('overclocked');
            clearInterval(hudInterval);
            hudInterval = setInterval(updateHud, 150); // Hyper-fast HUD updates
            updateHud();
          } else {
            mcuBoard.classList.remove('overclocked');
            clearInterval(hudInterval);
            hudInterval = setInterval(updateHud, 2000); // Back to normal speed
            
            // Reset state node manually
            if (stateNode) {
              stateNode.innerText = "OPTIMAL";
              stateNode.style.color = "#00f2fe";
              stateNode.style.textShadow = "0 0 10px #00f2fe";
            }
            updateHud();
          }
        });
      }
      
      // ── Ambient background mouse follow
      document.addEventListener('mousemove', (e) => {
        const bgOrbs = document.querySelector('.ambient-bg');
        if (bgOrbs) {
          const x = e.clientX / window.innerWidth;
          const y = e.clientY / window.innerHeight;
          bgOrbs.style.transform = `translate(${x * -20}px, ${y * -20}px)`;
        }
      });

    </script>
  </body>
</html>
