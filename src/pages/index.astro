    desc: "Optional: a working demo of your software component [It can be MVP link or youtube video link]",
    icon: "⚙️",
    tag: "Optional",
    color: "blue",
  },
  {
    title: "Hardware Demo Video",
    desc: "Optional: showcase your hardware integration on video , The video must be uploaded to YouTube and the link shared",
    icon: "🎥",
    tag: "Optional",
    color: "blue",
  },
];

const features = [
  {
    icon: "💡",
    num: "01",
    title: "Innovation First",
    desc: "Build solutions combining software intelligence with hardware creativity.",
  },
  {
    icon: "⚙️",
    num: "02",
    title: "Integration Focus",
    desc: "Master embedded systems, IoT, and web platforms in one cohesive prototype.",
  },
  {
    icon: "🚀",
    num: "03",
    title: "Real Impact",
    desc: "Cross-year teams (1st–4th year) working on projects that matter.",
  },
];

const siteUrl = "https://iie-code-craft.vercel.app";
const pageTitle = "CODECRAFT 2026 | Hackathon by IIE Tech Club";
const pageDescription =
  "Register for CODECRAFT 2026, the IIE Tech Club hackathon at Ideal Institute of Engineering where student teams build software and hardware prototypes with live demos, prizes, and certificates.";
const pageKeywords =
  "CODECRAFT, CODECRAFT 2026, IIE Tech Club, Ideal Institute of Engineering hackathon, hardware hackathon, software hardware project competition, student hackathon, software hackathon";
const socialImage = `${siteUrl}/CodeCraft.png`;

const eventStructuredData = {
  "@context": "https://schema.org",
  "@type": "Event",
  name: "CODECRAFT 2026",
  description: pageDescription,
  url: siteUrl,
  image: [socialImage],
  startDate: "2026-08-20T09:00:00+05:30",
  endDate: "2026-09-25T18:00:00+05:30",
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  eventStatus: "https://schema.org/EventScheduled",
  keywords: pageKeywords,
  location: {
    "@type": "Place",
    name: "Ideal Institute of Engineering",
    address: "Ideal Institute of Engineering campus",
  },
  organizer: {
    "@type": "Organization",
    name: "IIE Tech Club",
    url: siteUrl,
  },
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={pageKeywords} />
    <meta name="author" content="IIE Tech Club" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#020811" />
    <meta name="format-detection" content="telephone=yes" />
    <link rel="canonical" href={siteUrl} />
    <title>{pageTitle}</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CODECRAFT" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="352" />
    <meta property="og:image:height" content="236" />
    <meta
      property="og:image:alt"
      content="CODECRAFT hackathon logo"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImage} />
    <meta
      name="twitter:image:alt"
      content="CODECRAFT hackathon logo"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Orbitron:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/png" href="/CodeCraft.png" />
    <link rel="apple-touch-icon" href="/CodeCraft.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" as="image" href={logoImg.src} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(eventStructuredData)}
    />
  </head>

  <body>
    <!-- ── Page shell ── -->
    <div class="page-shell" id="page-shell">
      <!-- Ambient background orbs -->
      <div
        class="ambient-bg"
        aria-hidden="true"
        style="position:fixed;inset:0;pointer-events:none;z-index:0;"
      >
        <div
          style="position:absolute;width:700px;height:700px;background:#4facfe;top:-100px;left:-200px;border-radius:50%;filter:blur(140px);opacity:0.06;"
        >
        </div>
        <div
          style="position:absolute;width:700px;height:700px;background:#8e2de2;bottom:-100px;right:-150px;border-radius:50%;filter:blur(140px);opacity:0.06;"
        >
        </div>
        <div
          style="position:absolute;width:500px;height:500px;background:#00f2fe;top:40%;left:55%;border-radius:50%;filter:blur(140px);opacity:0.04;transform:translate(-50%,-50%);"
        >
        </div>
      </div>

      <CustomCursor />
      <Loader logoSrc={logoImg.src} />

      <Navbar />

      <main id="main-content">
        <!-- ══════════════════════════════════════════════ HERO ══ -->
        <section class="hero" id="home" aria-label="Hero">
          <div class="hero-grid-bg" aria-hidden="true"></div>

          <div class="wrap" style="position:relative;z-index:2;">
            <div class="hero-content">
              <!-- Left text column -->
              <div class="hero-text">
                <div class="hero-eyebrow">
                  <span class="eyebrow-dot" aria-hidden="true"></span>
                  IIE Tech Club · Ideal Institute of Engineering
                </div>

                <h1 class="hero-heading">
                  <span class="hero-heading-code">CODE</span><span
                    class="hero-heading-craft">CRAFT</span
                  >
                </h1>

                <p class="hero-tagline">Where Software Meets Hardware</p>

                <p
                  class="hero-desc"
                  style="color:var(--c-cyan); 
  text-shadow: 0 0 15px rgba(0, 242, 254, 0.4);"
                >
                  Bridge the gap between virtual logic and physical circuits.
                  Join the ultimate hackathon where raw code
                  meets real engineering.
                </p>
                <!-- Countdown -->
                <div
                  class="countdown"
                  id="countdown"
                  aria-label="Time until event"
                >
                  <div class="cd-unit">
                    <span class="cd-val" id="cd-days">--</span>
                    <span class="cd-lbl">Days</span>
                  </div>
                  <span class="cd-sep" aria-hidden="true">:</span>
                  <div class="cd-unit">
                    <span class="cd-val" id="cd-hours">--</span>
                    <span class="cd-lbl">Hours</span>
                  </div>
                  <span class="cd-sep" aria-hidden="true">:</span>
                  <div class="cd-unit">
                    <span class="cd-val" id="cd-mins">--</span>
                    <span class="cd-lbl">Mins</span>
                  </div>
                  <span class="cd-sep" aria-hidden="true">:</span>
                  <div class="cd-unit">
                    <span class="cd-val" id="cd-secs">--</span>
                    <span class="cd-lbl">Secs</span>
                  </div>
                </div>

                <!-- CTAs -->
                <div class="hero-actions">
                  <button
                    type="button"
                    class="btn-primary"
                    id="hero-register-btn"
                    onclick="window.location.href = '/coming-soon'"
                  >
                    Register Now
                    <svg
                      viewBox="0 0 20 20"
                      fill="none"
                      aria-hidden="true"
                      style="width:16px;height:16px;"
                    >
                      <path
                        d="M4 10h12M12 5l5 5-5 5"
                        stroke="currentColor"
                        stroke-width="2.2"
                        stroke-linecap="round"
                        stroke-linejoin="round"></path>
                    </svg>
                  </button>
                  <button
                    class="btn-ghost"
                    type="button"
                    data-scroll-to="#about"
                    id="hero-learn-btn"
                  >
                    Learn More ↓
                  </button>
                </div>
              </div>

              <!-- Right visual column -->
              <div class="hero-visual" aria-hidden="true">
                <div class="cyber-station">
                  <!-- Abstract Circuit Lines -->
                  <div class="circuit-bg">
                    <svg viewBox="0 0 400 400" preserveAspectRatio="none">
                      <path
                        d="M 0 50 L 150 50 L 200 100 L 400 100"
                        class="circuit-path p1"></path>
                      <path
                        d="M 400 300 L 250 300 L 200 250 L 0 250"
                        class="circuit-path p2"></path>
                      <path
                        d="M 100 0 L 100 120 L 150 170 L 150 400"
                        class="circuit-path p3"></path>
                      <path
                        d="M 300 400 L 300 150 L 250 100"
                        class="circuit-path p4"></path>

                      <circle cx="150" cy="50" r="4" class="circuit-node"
                      ></circle>
                      <circle cx="200" cy="100" r="4" class="circuit-node"
                      ></circle>
                      <circle cx="250" cy="300" r="4" class="circuit-node"
                      ></circle>
                      <circle cx="200" cy="250" r="4" class="circuit-node"
                      ></circle>
                      <circle cx="100" cy="120" r="4" class="circuit-node"
                      ></circle>
                      <circle cx="150" cy="170" r="4" class="circuit-node"
                      ></circle>
                      <circle cx="250" cy="100" r="4" class="circuit-node"
                      ></circle>
                      <circle cx="300" cy="150" r="4" class="circuit-node"
                      ></circle>
                    </svg>
                  </div>

                  <!-- Hardware Microcontroller -->
                  <div class="mcu-board" id="interactive-mcu" title="Click to Overclock">
                    <div class="mcu-core">
                      <img
                        src={logoImg.src}
                        width={logoImg.width}
                        height={logoImg.height}
                        alt="CodeCraft hardware hackathon logo"
                        class="mcu-logo"
                        decoding="async"
                        fetchpriority="high"
                      />
                    </div>
                    <div class="mcu-pins top">
                      <i></i><i></i><i></i><i></i><i></i><i></i>
                    </div>
                    <div class="mcu-pins bottom">
                      <i></i><i></i><i></i><i></i><i></i><i></i>
                    </div>
                    <div class="mcu-pins left">
                      <i></i><i></i><i></i><i></i>
                    </div>
                    <div class="mcu-pins right">
                      <i></i><i></i><i></i><i></i>
                    </div>

                    <div class="mcu-led led-tx"></div>
                    <div class="mcu-led led-rx"></div>
                  </div>

                  <!-- Glass Terminal overlapping -->
                  <div class="glass-terminal" id="interactive-terminal">
                    <!-- Resize Handles -->
                    <div class="resizer-h r-t" data-direction="t"></div>
                    <div class="resizer-h r-r" data-direction="r"></div>
                    <div class="resizer-h r-b" data-direction="b"></div>
                    <div class="resizer-h r-l" data-direction="l"></div>
                    
                    <div class="term-header" id="term-reboot-btn" title="Click to Reboot System" style="cursor: pointer;">
                      <div class="term-btns">
                        <span></span><span></span><span></span>
                      </div>
                      <div class="term-title">bash - root@codecraft</div>
                    </div>
                    <div class="term-body" id="term-body">
                      <div id="term-history">
                        <div class="t-line">
                          <span class="t-prompt">root@codecraft:~#</span> ./init_hardware.sh
                        </div>
                        <div class="t-line t-process">
                          [ OK ] Booting neural subsystem...
                        </div>
                        <div class="t-line t-process">
                          [ OK ] Linking code to logic gates...
                        </div>
                        <div class="t-line t-process">
                          [ OK ] Hardware synced successfully!
                        </div>
                        <div class="t-line">
                          <span class="t-prompt">root@codecraft:~#</span> execute_hackathon.exe
                        </div>
                        <div class="t-line t-success">
                          &gt;&gt; COMPILING INNOVATION...
                        </div>
                      </div>
                      <div class="t-line active-prompt">
                        <span class="t-prompt">root@codecraft:~#</span>
                        <input type="text" id="term-input" autocomplete="off" spellcheck="false" maxlength="50" />
                        <span class="t-cursor"></span>
                      </div>
                    </div>
                  </div>

                  <!-- Floating HUD elements -->
                  <div class="hud-box hud-tr">
                    <span class="hud-lbl">SYS.STATE</span>
                    <span class="hud-val pulse-val">OPTIMAL</span>
                  </div>

                  <div class="hud-box hud-bl">
                    <span class="hud-lbl">LATENCY</span>
                    <span class="hud-val">12ms</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
          
          <style>
            /* Interactive Overclock Styles */
            #interactive-mcu {
              cursor: pointer;
              transition: all 0.3s ease;
            }
            #interactive-mcu:hover {
              box-shadow: 0 0 30px rgba(0, 242, 254, 0.4);
            }
            #interactive-mcu.overclocked {
              animation: mcu-shake 0.5s infinite;
              box-shadow: 0 0 40px rgba(255, 60, 0, 0.6), inset 0 0 20px rgba(255, 60, 0, 0.4);
              border-color: rgba(255, 60, 0, 0.8);
            }
            #interactive-mcu.overclocked .mcu-logo {
              filter: hue-rotate(-90deg) brightness(1.5) drop-shadow(0 0 10px red);
              animation: logo-spin 1.5s linear infinite;
            }
            #interactive-mcu.overclocked .mcu-led {
              animation-duration: 0.1s !important;
              background: #ff2a00;
              box-shadow: 0 0 15px #ff2a00;
            }
            #interactive-mcu.overclocked .mcu-pins i {
              background: #ff8c42;
              box-shadow: 0 0 5px #ff8c42;
            }

            @keyframes mcu-shake {
              0% { transform: translate(0, 0) rotate(0deg); }
              25% { transform: translate(1px, 1px) rotate(0.5deg); }
              50% { transform: translate(-1px, -1px) rotate(-0.5deg); }
              75% { transform: translate(-1px, 1px) rotate(0deg); }
              100% { transform: translate(1px, -1px) rotate(0.5deg); }
            }
            @keyframes logo-spin {
              0% { transform: rotate(0deg) scale(1.1); }
              100% { transform: rotate(360deg) scale(1.1); }
            }
            
            #term-reboot-btn:hover {
              background: rgba(0, 242, 254, 0.1);
            }

            /* Interactive Terminal Styles */
            .term-body {
              display: flex;
              flex-direction: column;
              height: 220px;
              overflow-y: auto;
              scrollbar-width: none;
              scroll-behavior: smooth;
            }
            .term-body::-webkit-scrollbar {
              display: none;
            }
            .active-prompt {
              display: flex !important;
              align-items: center !important;
              gap: 8px !important;
              opacity: 1 !important;
              visibility: visible !important;
            }
            #term-input {
              background: transparent;
              border: none;
              color: var(--c-cyan);
              font-family: var(--font-mono);
              font-size: 0.8rem;
              outline: none;
              width: 2px; /* starts small */
              min-width: 2px;
              padding: 0;
              margin: 0;
              caret-color: transparent;
              text-shadow: 0 0 5px rgba(0, 242, 254, 0.5);
              flex: 0 1 auto; /* don't grow */
            }
            .t-cursor {
              display: inline-block;
              width: 8px;
              height: 14px;
              background: var(--c-cyan);
              animation: term-blink 1s step-end infinite;
              flex-shrink: 0;
              box-shadow: 0 0 8px var(--c-cyan);
              margin-left: -2px; /* overlap slightly for better look */
            }
            @keyframes term-blink {
              50% { opacity: 0; }
            }
            .command-output {
              color: #94a3b8;
              margin-bottom: 0.5rem;
              font-size: 0.75rem;
              line-height: 1.4;
              padding-left: 4px;
              border-left: 1px solid rgba(0, 242, 254, 0.1);
            }
            .term-shake {
              animation: term-shake 0.3s cubic-bezier(.36,.07,.19,.97) both;
            }
            @keyframes term-shake {
              10%, 90% { transform: translate3d(-1px, 0, 0); }
              20%, 80% { transform: translate3d(2px, 0, 0); }
              30%, 50%, 70% { transform: translate3d(-4px, 0, 0); }
              40%, 60% { transform: translate3d(4px, 0, 0); }
            }
            #page-shell.critical-state {
              background-color: rgba(255, 42, 0, 0.05);
              transition: background-color 0.5s ease;
            }

            /* Terminal Resizer Styles */
            .glass-terminal {
              min-width: 280px;
              min-height: 200px;
              max-width: 90vw;
              max-height: 80vh;
              position: absolute !important;
            }
            .resizer-h {
              position: absolute;
              z-index: 10;
            }
            .resizer-h.r-t { top: -4px; left: 0; right: 0; height: 8px; cursor: ns-resize; }
            .resizer-h.r-r { top: 0; bottom: 0; right: -4px; width: 8px; cursor: ew-resize; }
            .resizer-h.r-b { bottom: -4px; left: 0; right: 0; height: 8px; cursor: ns-resize; }
            .resizer-h.r-l { top: 0; bottom: 0; left: -4px; width: 8px; cursor: ew-resize; }
            
            .resizer-h:hover {
              background: rgba(0, 242, 254, 0.2);
            }

            /* New Glitch Reveal Animation */
            .glitch-reveal {
              opacity: 0;
              transform: translateY(10px);
              filter: blur(5px);
            }
            .in-view .glitch-reveal,
            .glitch-reveal.in-view {
              animation: glitch-reveal-anim 0.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
            }

            @keyframes glitch-reveal-anim {
              0% {
                opacity: 0;
                transform: translateY(20px) skewX(10deg);
                filter: blur(10px);
              }
              20% {
                opacity: 0.5;
                transform: translateY(-5px) skewX(-5deg);
                filter: blur(2px);
              }
              40% {
                opacity: 0.3;
                transform: translateY(2px) skewX(2deg);
              }
              60% {
                opacity: 0.8;
                transform: translateY(0) skewX(0);
                filter: blur(0);
              }
              100% {
                opacity: 1;
                transform: translateY(0);
                filter: blur(0);
                text-shadow: 0 0 10px rgba(0, 242, 254, 0.3);
              }
            }
          </style>
        </section>

        <!-- ── Stats bar ── -->
