---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import CustomCursor from "../components/CustomCursor.astro";
import logoImg from "../assets/images/logo-high.png";
import "../styles/global.css";
import { pageKeywords, siteName, siteUrl, socialImage } from "../lib/siteConfig";

const pageTitle = "REGISTRATION STANDBY | CODECRAFT 2026";
const pageDescription = "Registration for CODECRAFT 2026 has not started yet. Stay tuned for further updates.";
const pageUrl = `${siteUrl}/coming-soon`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={pageKeywords} />
    <meta name="author" content="IIE Tech Club" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#020811" />
    <link rel="canonical" href={pageUrl} />
    <title>{pageTitle}</title>
    
    <!-- Meta tags for social share -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="352" />
    <meta property="og:image:height" content="236" />
    <meta property="og:image:alt" content="CODECRAFT hackathon logo" />
    
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="CODECRAFT hackathon logo" />
    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Orbitron:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/png" href="/CodeCraft.png" />
    <link rel="apple-touch-icon" href="/CodeCraft.png" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>

  <body>
    <div class="page-shell" id="page-shell">
      <!-- Ambient background orbs -->
      <div class="ambient-bg" aria-hidden="true" style="position:fixed;inset:0;pointer-events:none;z-index:0;">
        <div style="position:absolute;width:600px;height:600px;background:#4facfe;top:-100px;left:-100px;border-radius:50%;filter:blur(140px);opacity:0.07;"></div>
        <div style="position:absolute;width:600px;height:600px;background:#8e2de2;bottom:-100px;right:-100px;border-radius:50%;filter:blur(140px);opacity:0.07;"></div>
      </div>

      <CustomCursor />
      <Navbar />

      <main id="main-content">
        <section class="cs-simple-hero">
          <div class="hero-grid-bg" aria-hidden="true"></div>
          
          <div class="wrap cs-wrapper">
            <div class="cs-card">
              <!-- Animated Glowing Core Icon -->
              <div class="cs-logo-wrapper">
                <div class="logo-pulse"></div>
                <img src={logoImg.src} alt="CodeCraft Logo" class="cs-logo-img" />
              </div>
              
              <!-- System Eyebrow -->
              <div class="cs-eyebrow">
                <span class="eyebrow-dot"></span>
                SYSTEM STATUS // STANDBY_MODE
              </div>

              <!-- Main Copy -->
              <h1 class="cs-title">
                REGISTRATION <span class="accent-cyan">NOT STARTED YET</span>
              </h1>
              
              <p class="cs-desc">
                Cores are currently initializing. Please stay tuned for further updates regarding team registrations and telemetry syncs. 
              </p>
              
              <!-- Divider line -->
              <div class="cs-divider">
                <span class="divider-dot"></span>
              </div>

              <!-- Back home button -->
              <button 
                type="button" 
                class="btn-back"
                onclick="window.location.href = '/'"
              >
                <svg viewBox="0 0 16 16" fill="none" class="back-icon" aria-hidden="true">
                  <path d="M13 8H3M7 12L3 8l4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
                <span>Back to Home</span>
              </button>
            </div>
          </div>
        </section>
      </main>

      <Footer />
    </div>
  </body>
</html>

<style>
  .cs-simple-hero {
    position: relative;
    min-height: 100vh;
    background: #020811;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: 100px;
    padding-bottom: 80px;
  }

  .hero-grid-bg {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(rgba(0, 242, 254, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 242, 254, 0.02) 1px, transparent 1px);
    background-size: 50px 50px;
    background-position: center;
    mask-image: radial-gradient(circle at 50% 50%, black 50%, transparent 100%);
    -webkit-mask-image: radial-gradient(circle at 50% 50%, black 50%, transparent 100%);
    pointer-events: none;
    z-index: 1;
  }

  .cs-wrapper {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: center;
    width: 100%;
  }

  /* Beautiful glassmorphic card centered on page */
  .cs-card {
    background: rgba(3, 8, 18, 0.65);
    border: 1px solid rgba(0, 242, 254, 0.15);
    border-radius: 12px;
    padding: 3.5rem 3rem;
    max-width: 600px;
    width: 90%;
    text-align: center;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: 
      0 30px 60px rgba(0, 0, 0, 0.6),
      0 0 40px rgba(0, 242, 254, 0.04),
      inset 0 0 20px rgba(0, 242, 254, 0.02);
    position: relative;
    overflow: hidden;
  }

  /* Glowing cyan top accent border */
  .cs-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 40%;
    height: 2px;
    background: linear-gradient(90deg, transparent, #00f2fe, transparent);
    box-shadow: 0 0 10px #00f2fe;
  }

  /* Logo styling */
  .cs-logo-wrapper {
    position: relative;
    width: 80px;
    height: 80px;
    margin: 0 auto 1.75rem auto;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cs-logo-img {
    width: 56px;
    height: 56px;
    object-fit: contain;
    filter: drop-shadow(0 0 10px rgba(0, 242, 254, 0.5));
    position: relative;
    z-index: 2;
  }

  .logo-pulse {
    position: absolute;
    inset: 0px;
    border: 1.5px solid rgba(0, 242, 254, 0.3);
    border-radius: 50%;
    animation: ring-pulse 3s cubic-bezier(0.2, 0.8, 0.2, 1) infinite;
  }

  @keyframes ring-pulse {
    0% { transform: scale(0.85); opacity: 1; border-color: rgba(0, 242, 254, 0.4); }
    100% { transform: scale(1.35); opacity: 0; border-color: transparent; }
  }

  /* Eyebrow badge */
  .cs-eyebrow {
    font-family: "Orbitron", sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    color: #4facfe;
    letter-spacing: 0.22em;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(79, 172, 254, 0.05);
    border: 1px solid rgba(79, 172, 254, 0.15);
    padding: 0.4rem 1rem;
    border-radius: 999px;
    margin-bottom: 1.5rem;
    text-shadow: 0 0 8px rgba(79, 172, 254, 0.25);
  }

  .eyebrow-dot {
    width: 6px;
    height: 6px;
    background-color: #00f2fe;
    border-radius: 50%;
    box-shadow: 0 0 6px #00f2fe;
    animation: dot-flicker 2s infinite alternate;
  }

  @keyframes dot-flicker {
    0% { opacity: 0.4; }
    100% { opacity: 1; }
  }

  /* Title & accents */
  .cs-title {
    font-family: "Orbitron", sans-serif;
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    font-weight: 900;
    line-height: 1.3;
    letter-spacing: 0.06em;
    color: #f0f6ff;
    margin: 0 0 1.25rem 0;
    text-transform: uppercase;
  }

  .accent-cyan {
    color: #00f2fe;
    text-shadow: 0 0 15px rgba(0, 242, 254, 0.3);
  }

  .cs-desc {
    font-size: 0.95rem;
    line-height: 1.7;
    color: #94a3b8;
    max-width: 480px;
    margin: 0 auto;
  }

  /* Cyberpunk divider */
  .cs-divider {
    position: relative;
    width: 60px;
    height: 1px;
    background: rgba(0, 242, 254, 0.2);
    margin: 2.25rem auto;
  }

  .divider-dot {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 5px;
    height: 5px;
    background: #00f2fe;
    border-radius: 50%;
    box-shadow: 0 0 6px #00f2fe;
  }

  /* Back Home button styling */
  .btn-back {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: transparent;
    color: #f0f6ff;
    border: 1px solid rgba(0, 242, 254, 0.3);
    padding: 0.75rem 1.75rem;
    border-radius: 6px;
    font-family: "Orbitron", sans-serif;
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    user-select: none;
    outline: none;
  }

  .btn-back:hover {
    color: #020811;
    background: linear-gradient(135deg, #00f2fe, #4facfe);
    border-color: transparent;
    box-shadow: 0 6px 24px rgba(0, 242, 254, 0.35);
    transform: translateY(-2px);
  }

  .btn-back:active {
    transform: translateY(0);
  }

  .back-icon {
    width: 16px;
    height: 16px;
    transition: transform 0.3s ease;
  }

  .btn-back:hover .back-icon {
    transform: translateX(-3px);
  }

  /* Responsive styling */
  @media (max-width: 576px) {
    .cs-card {
      padding: 2.5rem 1.5rem;
    }

    .cs-title {
      font-size: 1.6rem;
    }

    .cs-desc {
      font-size: 0.88rem;
    }
  }
</style>
