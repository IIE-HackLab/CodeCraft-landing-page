---
---
<div class="cursor-container" aria-hidden="true">
  <div id="cursor-dot"></div>
  <div id="cursor-ring">
    <div id="cursor-label"></div>
  </div>
  <div id="cursor-glow"></div>
</div>

<style is:global>
  @media (hover: hover) and (pointer: fine) {
    * {
      cursor: none !important;
    }
  }
</style>

<style>
  .cursor-container {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 99999;
  }

  @media (hover: hover) and (pointer: fine) {
    .cursor-container {
      display: block;
    }
  }

  /* Precision Dot */
  #cursor-dot {
    position: fixed;
    width: 6px;
    height: 6px;
    background: #00f2fe;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    transition: width 0.25s ease, height 0.25s ease, background 0.25s ease;
    z-index: 100001;
    pointer-events: none;
  }

  /* Adaptive Ring */
  #cursor-ring {
    position: fixed;
    width: 32px;
    height: 32px;
    border: 1.5px solid rgba(0, 242, 254, 0.45);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    transition: 
      width 0.35s cubic-bezier(0.16, 1, 0.3, 1), 
      height 0.35s cubic-bezier(0.16, 1, 0.3, 1), 
      border-color 0.3s ease,
      background 0.3s ease,
      border-radius 0.35s ease;
    z-index: 100000;
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Contextual Label */
  #cursor-label {
    font-family: var(--font-mono, monospace);
    font-size: 0.58rem;
    font-weight: 700;
    color: #00f2fe;
    letter-spacing: 0.12em;
    white-space: nowrap;
    opacity: 0;
    transform: scale(0.8);
    transition: opacity 0.25s ease, transform 0.25s ease;
    pointer-events: none;
  }

  /* Ambient Glow */
  #cursor-glow {
    position: fixed;
    width: 360px;
    height: 360px;
    background: radial-gradient(circle, rgba(0, 242, 254, 0.07) 0%, transparent 68%);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
    z-index: 99998;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  /* Hover States */
  .cursor-hover #cursor-dot {
    width: 4px;
    height: 4px;
    background: #ffffff;
  }

  .cursor-hover #cursor-ring {
    width: 48px;
    height: 48px;
    border-color: rgba(0, 242, 254, 0.85);
    background: rgba(0, 242, 254, 0.06);
    box-shadow: 0 0 16px rgba(0, 242, 254, 0.25);
  }

  /* Labeled Hover State */
  .cursor-labeled #cursor-dot {
    opacity: 0;
  }
  .cursor-labeled #cursor-ring {
    width: 76px;
    height: 32px;
    border-radius: 4px;
    border-color: #00f2fe;
    background: rgba(4, 12, 26, 0.88);
    box-shadow: 0 0 20px rgba(0, 242, 254, 0.35);
  }
  .cursor-labeled #cursor-label {
    opacity: 1;
    transform: scale(1);
  }

  /* Click State */
  .cursor-active #cursor-ring {
    transform: translate(-50%, -50%) scale(0.85);
    background: rgba(0, 242, 254, 0.2);
    border-color: #00f2fe;
  }
</style>

<script is:inline>
  const dot = document.getElementById("cursor-dot");
  const ring = document.getElementById("cursor-ring");
  const glow = document.getElementById("cursor-glow");
  const label = document.getElementById("cursor-label");
  const container = document.querySelector(".cursor-container");

  let mouseX = -100;
  let mouseY = -100;
  let ringX = -100;
  let ringY = -100;

  const lerpFactor = 0.18;

  document.addEventListener("pointermove", (e) => {
    mouseX = e.clientX;
    mouseY = e.clientY;
    
    if (dot) {
      dot.style.left = mouseX + "px";
      dot.style.top = mouseY + "px";
    }

    if (glow) {
      glow.style.left = mouseX + "px";
      glow.style.top = mouseY + "px";
      glow.style.opacity = "1";
    }
  });

  function animate() {
    ringX += (mouseX - ringX) * lerpFactor;
    ringY += (mouseY - ringY) * lerpFactor;

    if (ring) {
      ring.style.left = ringX + "px";
      ring.style.top = ringY + "px";
    }

    requestAnimationFrame(animate);
  }
  animate();

  document.addEventListener("mousedown", () => container?.classList.add("cursor-active"));
  document.addEventListener("mouseup", () => container?.classList.remove("cursor-active"));

  document.addEventListener("mouseover", (e) => {
    const target = e.target;
    if (!target) return;

    // Check custom explicit label first
    const labelEl = target.closest('[data-cursor]');
    if (labelEl && label) {
      const customText = labelEl.getAttribute('data-cursor');
      label.textContent = customText;
      container?.classList.add('cursor-labeled');
      container?.classList.remove('cursor-hover');
      return;
    }

    // Contextual detection for key elements
    const ctaBtn = target.closest('#hero-register-btn, .btn-primary, .nav-cta');
    if (ctaBtn && label) {
      label.textContent = '[ENTER]';
      container?.classList.add('cursor-labeled');
      return;
    }

    const wbItem = target.closest('.code-panel, .core-assembly, .hardware-module');
    if (wbItem && label) {
      if (wbItem.classList.contains('code-panel')) label.textContent = '[CODE]';
      else if (wbItem.classList.contains('core-assembly')) label.textContent = '[CORE]';
      else if (wbItem.classList.contains('hardware-module')) label.textContent = '[CIRCUIT]';
      container?.classList.add('cursor-labeled');
      return;
    }

    const roadCard = target.closest('.road-event-card, .road-cp');
    if (roadCard && label) {
      label.textContent = '[CHECKPOINT]';
      container?.classList.add('cursor-labeled');
      return;
    }

    const orgCard = target.closest('.org-card');
    if (orgCard && label) {
      label.textContent = '[PROFILE]';
      container?.classList.add('cursor-labeled');
      return;
    }

    const protoRule = target.closest('.proto-rule, .protocol-item');
    if (protoRule && label) {
      label.textContent = '[PROTOCOL]';
      container?.classList.add('cursor-labeled');
      return;
    }

    // Generic interactive element
    if (target.closest('a, button, [role="button"], input, textarea, .core-module, .bounty-card, .comm-link')) {
      container?.classList.remove('cursor-labeled');
      container?.classList.add('cursor-hover');
    }
  });

  document.addEventListener("mouseout", (e) => {
    const target = e.target;
    if (target.closest('a, button, [role="button"], input, textarea, [data-cursor], .core-module, .bounty-card, .org-card, .road-event-card, .road-cp, .comm-link')) {
      container?.classList.remove('cursor-hover');
      container?.classList.remove('cursor-labeled');
    }
  });

  document.addEventListener("pointerleave", () => {
    if (glow) glow.style.opacity = "0";
    if (dot) dot.style.opacity = "0";
    if (ring) ring.style.opacity = "0";
  });

  document.addEventListener("pointerenter", () => {
    if (dot) dot.style.opacity = "1";
    if (ring) ring.style.opacity = "1";
  });
</script>
