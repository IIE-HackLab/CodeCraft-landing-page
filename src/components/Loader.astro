---
interface Props {
  logoSrc: string;
}
const { logoSrc } = Astro.props;
---

<div class="loader-overlay" id="loader" aria-hidden="true">
  <!-- Scanline Overlay -->
  <div class="scanline"></div>

  <!-- Animated Background -->
  <div class="loader-bg">
    <div class="loader-grid"></div>
    <div class="glow-orb glow-1"></div>
    <div class="glow-orb glow-2"></div>
    <div class="glow-orb glow-3"></div>
  </div>

  <div class="loader-content">
    <!-- Animated Logo -->
    <div class="logo-container">
      <div class="logo-frame">
        <img src={logoSrc} alt="CodeCraft" class="loader-logo glitch-logo" />
        <div class="logo-pulse"></div>
        <div class="logo-shine"></div>
      </div>
    </div>

    <!-- Terminal Section -->
    <div class="terminal-builder">
      <div class="terminal-window">
        <div class="terminal-header">
          <div class="terminal-dots">
            <div class="code-dot red"></div>
            <div class="code-dot yellow"></div>
            <div class="code-dot green"></div>
          </div>
          <span class="terminal-title">SYS_BOOT_SEQ_V9</span>
          <span class="terminal-status" id="sys-status">OFFLINE</span>
        </div>
        <div class="terminal-content" id="terminal-content">
          <!-- JS injects lines here -->
        </div>
      </div>
    </div>

    <!-- Progress Bar -->
    <div class="loader-footer">
      <div class="progress-container">
        <div class="progress-bar">
          <div class="progress-fill" id="loader-progress"></div>
          <div class="progress-glow"></div>
        </div>
        <div class="progress-meta">
          <span id="loader-percent" class="glitch-text" data-text="0%">0%</span>
          <span class="pulse-text" id="loading-msg">PREPARING FOR IMMERSION...</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .loader-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: #02040a;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: var(--c-cyan, #00f2fe);
    font-family: var(--font-body), sans-serif;
    overflow: hidden;
    transition: transform 1.2s cubic-bezier(0.8, 0, 0.2, 1), opacity 1s ease;
  }

  .loader-overlay.is-hidden {
    transform: translateY(-100%);
    pointer-events: none;
    opacity: 0;
  }

  /* Scanline Overlay */
  .scanline {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0) 50%, rgba(0, 0, 0, 0.2) 50%, rgba(0, 0, 0, 0.2));
    background-size: 100% 4px;
    z-index: 100;
    pointer-events: none;
    opacity: 0.6;
  }

  /* Background Animation */
  .loader-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .loader-grid {
    position: absolute;
    inset: -50%;
    background-image:
      linear-gradient(rgba(0, 242, 254, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 242, 254, 0.04) 1px, transparent 1px);
    background-size: 60px 60px;
    transform: perspective(500px) rotateX(60deg) translateY(-100px);
    animation: grid-move 4s linear infinite;
  }

  @keyframes grid-move {
    0% { transform: perspective(500px) rotateX(60deg) translateY(0); }
    100% { transform: perspective(500px) rotateX(60deg) translateY(60px); }
  }

  .glow-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.15;
    animation: float 8s ease-in-out infinite;
  }

  .glow-1 {
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(0, 242, 254, 0.5), transparent);
    top: -100px;
    left: -100px;
    animation-delay: 0s;
  }

  .glow-2 {
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(79, 172, 254, 0.4), transparent);
    bottom: -150px;
    right: -150px;
    animation-delay: 2s;
  }

  .glow-3 {
    width: 350px;
    height: 350px;
    background: radial-gradient(circle, rgba(142, 45, 226, 0.3), transparent);
    top: 50%;
    right: 10%;
    animation-delay: 4s;
  }

  @keyframes float {
    0%, 100% { transform: translate(0, 0); }
    33% { transform: translate(30px, -30px); }
    66% { transform: translate(-20px, 20px); }
  }

  /* Content Layout */
  .loader-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3rem;
    max-width: 800px;
    width: 90%;
  }

  /* Logo Container */
  .logo-container {
    display: flex;
    justify-content: center;
  }

  .logo-frame {
    position: relative;
    width: 140px;
    height: 140px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .loader-logo {
    width: 110px;
    height: 110px;
    object-fit: contain;
    filter: drop-shadow(0 0 25px rgba(0, 242, 254, 0.8));
    animation: logo-float 3s ease-in-out infinite, glitch-anim 5s infinite;
    position: relative;
    z-index: 2;
  }

  @keyframes logo-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  @keyframes glitch-anim {
    0% { filter: drop-shadow(0 0 25px rgba(0, 242, 254, 0.8)); transform: translate(0); }
    20% { filter: drop-shadow(0 0 25px rgba(0, 242, 254, 0.8)); transform: translate(0); }
    21% { filter: drop-shadow(3px 0 0 rgba(255,0,0,0.5)) drop-shadow(-3px 0 0 rgba(0,255,255,0.5)); transform: translate(-2px, 2px); }
    22% { filter: drop-shadow(-3px 0 0 rgba(255,0,0,0.5)) drop-shadow(3px 0 0 rgba(0,255,255,0.5)); transform: translate(2px, -2px); }
    23% { filter: drop-shadow(0 0 25px rgba(0, 242, 254, 0.8)); transform: translate(0); }
    100% { filter: drop-shadow(0 0 25px rgba(0, 242, 254, 0.8)); transform: translate(0); }
  }

  .logo-pulse {
    position: absolute;
    inset: -15px;
    border: 2px solid rgba(0, 242, 254, 0.4);
    border-radius: 50%;
    animation: pulse-ring 2.5s cubic-bezier(0.215, 0.610, 0.355, 1) infinite;
  }

  .logo-shine {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: conic-gradient(from 0deg, transparent, rgba(0, 242, 254, 0.4), transparent);
    animation: spin-shine 2s linear infinite;
  }

  @keyframes pulse-ring {
    0% { transform: scale(0.8); opacity: 1; border-color: rgba(0, 242, 254, 0.8); }
    100% { transform: scale(1.6); opacity: 0; border-color: transparent; }
  }

  @keyframes spin-shine {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  /* Terminal Section */
  .terminal-builder {
    width: 100%;
    max-width: 650px;
    perspective: 1000px;
  }

  .terminal-window {
    background: rgba(4, 8, 16, 0.85);
    border: 1px solid rgba(0, 242, 254, 0.3);
    border-radius: 4px;
    overflow: hidden;
    box-shadow: 0 0 30px rgba(0, 242, 254, 0.1), inset 0 0 20px rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(10px);
    transform: rotateX(5deg);
    transition: transform 0.3s ease;
  }

  .terminal-window:hover {
    transform: rotateX(0deg);
  }

  .terminal-header {
    background: rgba(0, 242, 254, 0.1);
    padding: 0.5rem 1rem;
    display: flex;
    align-items: center;
    border-bottom: 1px solid rgba(0, 242, 254, 0.2);
  }

  .terminal-dots {
    display: flex;
    gap: 6px;
  }

  .code-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .code-dot.red { background: #ff5f56; box-shadow: 0 0 8px #ff5f56; }
  .code-dot.yellow { background: #ffbd2e; box-shadow: 0 0 8px #ffbd2e; }
  .code-dot.green { background: #27c93f; box-shadow: 0 0 8px #27c93f; }

  .terminal-title {
    margin-left: 1rem;
    font-size: 0.7rem;
    color: rgba(0, 242, 254, 0.8);
    font-family: var(--font-mono), monospace;
    letter-spacing: 0.15em;
    font-weight: bold;
  }

  .terminal-status {
    margin-left: auto;
    font-size: 0.65rem;
    color: #ff5f56;
    font-family: var(--font-mono), monospace;
    letter-spacing: 0.1em;
    animation: blink 1s infinite;
  }

  .terminal-status.online {
    color: #27c93f;
    animation: none;
    text-shadow: 0 0 8px #27c93f;
  }

  .terminal-content {
    padding: 1.5rem;
    font-family: var(--font-mono), monospace;
    font-size: 0.85rem;
    color: #00f2fe;
    height: 180px;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    overflow: hidden;
    position: relative;
    text-shadow: 0 0 5px rgba(0, 242, 254, 0.5);
  }

  .terminal-content::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0; height: 30px;
    background: linear-gradient(transparent, rgba(4, 8, 16, 0.9));
  }

  .term-line {
    opacity: 0;
    transform: translateY(10px);
    animation: line-appear 0.2s forwards;
  }

  .term-prefix {
    color: #4facfe;
    margin-right: 8px;
  }

  .term-success { color: #27c93f; }
  .term-warn { color: #ffbd2e; }
  .term-err { color: #ff5f56; }

  .term-cursor {
    display: inline-block;
    width: 8px;
    height: 15px;
    background: #00f2fe;
    margin-left: 5px;
    animation: blink 1s step-end infinite;
    vertical-align: middle;
  }

  @keyframes line-appear {
    to { opacity: 1; transform: translateY(0); }
  }

  /* Footer & Progress */
  .loader-footer {
    width: 100%;
    max-width: 650px;
    margin-top: auto;
  }

  .progress-container {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .progress-bar {
    width: 100%;
    height: 4px;
    background: rgba(0, 242, 254, 0.05);
    overflow: hidden;
    position: relative;
    border: 1px solid rgba(0, 242, 254, 0.2);
  }

  .progress-fill {
    width: 0%;
    height: 100%;
    background: #00f2fe;
    box-shadow: 0 0 15px #00f2fe, 0 0 30px #4facfe;
    transition: width 0.1s linear;
    position: relative;
  }

  .progress-glow {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 50px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.8), transparent);
    filter: blur(5px);
    animation: progress-scan 1s infinite linear;
    mix-blend-mode: overlay;
  }

  @keyframes progress-scan {
    0% { transform: translateX(-100px); }
    100% { transform: translateX(800px); }
  }

  .progress-meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    color: rgba(0, 242, 254, 0.8);
    font-family: var(--font-mono), monospace;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .pulse-text {
    animation: text-flicker 3s linear infinite;
  }

  @keyframes text-flicker {
    0%, 19%, 21%, 23%, 25%, 54%, 56%, 100% { opacity: 1; }
    20%, 24%, 55% { opacity: 0.5; }
    22% { opacity: 0.3; }
  }

  @keyframes blink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }

  /* Responsive */
  @media (max-width: 640px) {
    .loader-content {
      gap: 2rem;
    }
    .terminal-content {
      font-size: 0.7rem;
      height: 150px;
    }
    .progress-meta {
      font-size: 0.6rem;
    }
  }
</style>

<script>
  const loader = document.getElementById('loader');
  const progress = document.getElementById('loader-progress');
  const percent = document.getElementById('loader-percent');
  const msg = document.getElementById('loading-msg');
  const termContent = document.getElementById('terminal-content');
  const sysStatus = document.getElementById('sys-status');
  
  const originalBodyOverflow = document.body.style.overflow;
  const originalRootOverflow = document.documentElement.style.overflow;
  const originalScrollBehavior = document.documentElement.style.scrollBehavior;

  if ('scrollRestoration' in history) {
    history.scrollRestoration = 'manual';
  }

  function forceTopScroll() {
    document.documentElement.style.scrollBehavior = 'auto';
    document.documentElement.scrollTop = 0;
    document.body.scrollTop = 0;
    window.scrollTo({ top: 0, left: 0, behavior: 'instant' });
  }

  function clearInitialHashScroll() {
    if (!window.location.hash) return;
    history.replaceState(null, document.title, window.location.pathname + window.location.search);
  }

  const bootLogs = [
    { text: "Initiating neural handshake...", delay: 200 },
    { text: "Bypassing mainstream protocols [OK]", delay: 400, type: "term-success" },
    { text: "Decrypting hackathon matrix...", delay: 700 },
    { text: "Warning: High energy output detected", delay: 1000, type: "term-warn" },
    { text: "Synthesizing innovation nodes...", delay: 1300 },
    { text: "Compiling reality distortion field [DONE]", delay: 1700, type: "term-success" },
    { text: "Loading CodeCraft core engine...", delay: 2000 },
    { text: "Override limits active.", delay: 2300, type: "term-warn" },
    { text: "System fully operational.", delay: 2600, type: "term-success" },
    { text: "Welcome to the next level.", delay: 2900 }
  ];

  async function startLoader() {
    forceTopScroll();
    clearInitialHashScroll();
    document.body.style.overflow = 'hidden';
    document.documentElement.style.overflow = 'hidden';

    // Terminal Boot Sequence
    let timeOffset = 0;
    let activeCursor: HTMLSpanElement | null = null;
    
    bootLogs.forEach((log, index) => {
      setTimeout(() => {
        if (activeCursor) {
          activeCursor.remove();
        }
        
        if (termContent) {
          const line = document.createElement('div');
          line.className = 'term-line';
          
          let colorClass = log.type ? log.type : '';
          
          line.innerHTML = `<span class="term-prefix">~</span><span class="${colorClass}">${log.text}</span>`;
          
          // Add cursor to the last line
          if (index < bootLogs.length - 1) {
             const cursor = document.createElement('span');
             cursor.className = 'term-cursor';
             line.appendChild(cursor);
             activeCursor = cursor;
          }
          
          termContent.appendChild(line);
          termContent.scrollTop = termContent.scrollHeight;
          
          // Status updates
          if (index === 2 && sysStatus) {
            sysStatus.textContent = 'BOOTING...';
            sysStatus.style.color = '#ffbd2e';
          }
          if (index === 8 && sysStatus) {
            sysStatus.textContent = 'ONLINE';
            sysStatus.className = 'terminal-status online';
          }
        }
      }, log.delay);
    });

    // Progress animation mapping to the 3.5s boot sequence
    let progress_value = 0;
    const progressInterval = setInterval(() => {
      // Exponential-like progress
      progress_value += (100 - progress_value) * 0.08 + Math.random() * 2;
      
      if (progress_value >= 100) {
        progress_value = 100;
        clearInterval(progressInterval);
        if (msg) msg.textContent = "SYSTEM READY. ENTERING...";
      }
      
      if (progress) progress.style.width = `${progress_value}%`;
      if (percent) {
        percent.textContent = `${Math.floor(progress_value)}%`;
        percent.setAttribute('data-text', `${Math.floor(progress_value)}%`);
      }
    }, 50);

    // Final unlock
    setTimeout(() => {
      forceTopScroll();
      if (loader) loader.classList.add('is-hidden');
      document.body.style.overflow = originalBodyOverflow;
      document.documentElement.style.overflow = originalRootOverflow;
      document.documentElement.style.scrollBehavior = originalScrollBehavior;
    }, 4000);
  }

  // Start when page is ready
  if (document.readyState === 'complete') {
    startLoader();
  } else {
    window.addEventListener('load', startLoader);
  }
</script>
